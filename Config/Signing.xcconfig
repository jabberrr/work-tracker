// Signing for both targets (the base configuration of both targets in Worklog.xcodeproj).
//
// Default: signed with the project team, full entitlements (iCloud/CloudKit, push for CloudKit, Sign in with Apple).
// Requires a paid Apple Developer Program membership — free "Personal Team" accounts can't use iCloud or Sign in with Apple.
//
// To build WITHOUT a team (ad-hoc "Sign to Run Locally", local-only storage, no Sign in with Apple), copy
// Config/Local.xcconfig.example to Config/Local.xcconfig (git-ignored).

WORKLOG_TEAM = 6W4ZKDHBVD
WORKLOG_SIGN_IDENTITY = Apple Development
WORKLOG_ENTITLEMENTS = Worklog/Resources/Worklog.entitlements

#include? "Local.xcconfig"
